generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Player {
  id     String  @id @default(cuid())
  name   String  @unique
  token  String  @unique
  active Boolean @default(true)

  ducks    Float
  money    Float
  lastSync DateTime @default(now())

  totalDucksProduced  BigInt @default(0)
  totalDucksSold      BigInt @default(0)
  totalMoneyGenerated BigInt @default(0)
  totalBuildings      Int    @default(0)
  totalStorage        Int    @default(0)

  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  buildings    PlayerBuilding[]
  storages     PlayerStorage[]
  achievements PlayerAchievement[]
}

model PlayerBuilding {
  buildingId String
  playerId   String

  amount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id])

  @@id([buildingId, playerId])
}

model PlayerStorage {
  storageId String
  playerId  String

  amount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id])

  @@id([storageId, playerId])
}

model PlayerAchievement {
  achievementId String
  playerId      String

  unlockedAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@id([achievementId, playerId])
}

model WorldState {
  id Int @id @default(1)

  totalDucksProduced  BigInt @default(0)
  totalDucksSold      BigInt @default(0)
  totalMoneyGenerated BigInt @default(0)

  createdAt  DateTime @default(now())
  lastUpdate DateTime @updatedAt
}

model IpBan {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  bannedAt  DateTime @default(now())
}
