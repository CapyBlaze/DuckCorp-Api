{
    "entryFile": "src/app.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": ["src/controllers/**/*.controller.ts"],
    "spec": {
        "outputDirectory": "docs",
        "specVersion": 3,
        "name": "DuckCorp API",
        "title": "DuckCorp API",
        "description": "A multiplayer idle game API where players build a rubber duck empire, produce ducks and sell them on the market.",
        "version": "1.0.0",
        "contact": {
            "name": "CapyBlaze",
            "email": "capyblaze@gmail.com"
        },
        "servers": ["duckcorp.capyblaze.hackclub.app"],
        "securityDefinitions": {
            "playerAuth": {
                "type": "http",
                "scheme": "bearer"
            },
            "adminAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    },
    "routes": {
        "routesDir": "src/generated",
        "authenticationModule": "src/middlewares/auth.middleware.ts"
    }
}
