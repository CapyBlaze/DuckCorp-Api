				"tags": [
					"Leaderboard"
				],
				"security": [
					{
						"bearerAuth": []
					}
				],
				"parameters": [
					{
						"description": "The criteria to sort the leaderboard by (default: byDucks)",
						"in": "query",
						"name": "sort",
						"required": false,
						"schema": {
							"$ref": "#/components/schemas/SortType"
						}
					},
					{
						"description": "The page number for pagination (default: 1)",
						"in": "query",
						"name": "page",
						"required": false,
						"schema": {
							"format": "int32",
							"type": "integer",
							"minimum": 1
						}
					},
					{
						"description": "The number of players to return per page (default: 10)",
						"in": "query",
						"name": "limit",
						"required": false,
						"schema": {
							"format": "int32",
							"type": "integer",
							"minimum": 1,
							"maximum": 20
						}
					}
				]
			}
		},
